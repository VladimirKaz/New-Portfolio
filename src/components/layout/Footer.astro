---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <p class="footer__copy">© {year} Владимир Казаков</p>
    <p class="footer__built">Сделано на Astro</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border);
    padding: var(--space-5) 0;
    margin-top: var(--space-8);
  }

  .footer__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .footer__copy,
  .footer__built {
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }
</style>
