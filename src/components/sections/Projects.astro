---
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<section id="projects" class="projects">
  <div class="container">
    <h2 class="section-title">Проекты</h2>

    {
      projects.length === 0 ? (
        <div class="projects__empty">
          <p class="projects__empty-title">Проекты в работе</p>
          <p class="projects__empty-text">
            Скоро здесь появятся работы. Сейчас собираю портфолио — первый
            проект уже в пути.
          </p>
        </div>
      ) : (
        <div class="projects__grid">
          {projects.map((project) => (
            <article class="project-card">
              {project.data.cover && (
                <img
                  src={project.data.cover}
                  alt={`Скриншот проекта ${project.data.title}`}
                  class="project-card__cover"
                  loading="lazy"
                />
              )}
              <div class="project-card__body">
                <div class="project-card__header">
                  <h3 class="project-card__title">{project.data.title}</h3>
                  {project.data.status === "wip" && (
                    <span class="project-card__status">в работе</span>
                  )}
                </div>
                <p class="project-card__summary">{project.data.summary}</p>
                <ul class="project-card__stack">
                  {project.data.stack.map((tech) => (
                    <li class="project-card__tag">{tech}</li>
                  ))}
                </ul>
                <div class="project-card__links">
                  {project.data.demoUrl && (
                    <a
                      href={project.data.demoUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="project-card__link"
                    >
                      Демо →
                    </a>
                  )}
                  {project.data.repoUrl && (
                    <a
                      href={project.data.repoUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="project-card__link"
                    >
                      Код →
                    </a>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      )
    }
  </div>
</section>

<style>
  .projects {
    padding: var(--space-8) 0;
  }

  .section-title {
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-5);
  }

  .projects__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-4);
  }

  .projects__empty {
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6) var(--space-4);
    text-align: center;
  }

  .projects__empty-title {
    font-weight: 600;
    margin-bottom: var(--space-2);
  }

  .projects__empty-text {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
  }

  .project-card {
    background-color: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition:
      border-color 0.2s,
      transform 0.2s;
  }

  .project-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  .project-card__cover {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
    border-bottom: 1px solid var(--color-border);
  }

  .project-card__body {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    flex: 1;
  }

  .project-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .project-card__title {
    font-size: 1.0625rem;
    font-weight: 600;
  }

  .project-card__status {
    font-size: 0.75rem;
    color: var(--color-accent);
    border: 1px solid var(--color-accent);
    border-radius: 999px;
    padding: 0.125rem 0.5rem;
    white-space: nowrap;
  }

  .project-card__summary {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    flex: 1;
  }

  .project-card__stack {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .project-card__tag {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.125rem 0.5rem;
  }

  .project-card__links {
    display: flex;
    gap: var(--space-4);
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-border);
  }

  .project-card__link {
    font-size: 0.875rem;
    font-weight: 500;
  }
</style>
