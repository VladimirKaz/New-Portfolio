---

---

<section class="hero">
  <div class="container">
    <p class="hero__greeting">Привет, я</p>
    <h1 class="hero__name">Владимир Казаков</h1>
    <p class="hero__role">Frontend-разработчик</p>
    <p class="hero__pitch">
      Учусь, делаю пет-проекты и ищу первую работу в команде, где смогу расти.
      Верстаю на HTML, CSS/SCSS и БЭМ, изучаю Astro.js и Vue.js.
    </p>
    <div class="hero__actions">
      <a href="#projects" class="btn btn--primary">Смотреть проекты</a>
      <a href="#contact" class="btn btn--ghost">Связаться</a>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: var(--space-8) 0;
  }

  .hero__greeting {
    color: var(--color-accent);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .hero__name {
    font-size: clamp(2rem, 6vw, 3.5rem);
    line-height: 1.1;
    font-weight: 700;
    margin-top: var(--space-2);
    letter-spacing: -0.02em;
  }

  .hero__role {
    font-size: clamp(1.125rem, 3vw, 1.5rem);
    color: var(--color-text-muted);
    margin-top: var(--space-2);
    font-weight: 500;
  }

  .hero__pitch {
    color: var(--color-text-muted);
    max-width: 560px;
    margin-top: var(--space-4);
    font-size: 1rem;
  }

  .hero__actions {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-5);
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-md);
    font-size: 0.9375rem;
    font-weight: 500;
    transition: all 0.2s;
  }

  .btn:hover {
    text-decoration: none;
  }

  .btn--primary {
    background-color: var(--color-accent);
    color: #0f1115;
  }

  .btn--primary:hover {
    filter: brightness(1.1);
  }

  .btn--ghost {
    border: 1px solid var(--color-border);
    color: var(--color-text);
  }

  .btn--ghost:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
</style>
